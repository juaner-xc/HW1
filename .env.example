# 任意 OpenAI 兼容模型服务均可使用；不要把真实密钥提交或发给别人。
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_API_KEY=填入你的模型密钥
LLM_MODEL=deepseek-chat

# QQ 机器人只在本机监听。NapCat 的反向 WebSocket 地址请填：
# ws://127.0.0.1:8091/onebot/v11/ws
QQ_BOT_PORT=8091

# 可选：填自己的 QQ 号后，机器人会识别“主人”。
BOT_OWNER_QQ=

# 代码审查工具允许读取的目录。默认是当前项目目录。
# CODE_AGENT_WORKSPACE=
